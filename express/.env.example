# The port the Express server runs on
PORT=8100

# Allowed frontend origins for CORS (comma separated)
FRONTEND_URL="http://localhost:5130, http://127.0.0.1:5130, https://localhost:5130, https://127.0.0.1:5130, http://localhost:5173, https://localhost:5173"

# Base URL for Better Auth (use https if you set up mkcert)
BETTER_AUTH_URL="https://localhost:8100"
