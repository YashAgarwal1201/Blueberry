#!/usr/bin/env bash
# ==============================================================================
# Blueberry Monorepo - Git Pre-Push Hook
# ==============================================================================
# Runs the local CI suite before pushing branches/tags to remote to ensure
# broken builds, failing tests, and lint/type violations are caught early.
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Check if deleting a remote branch (nothing to validate)
z40="0000000000000000000000000000000000000000"
is_delete=true

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$z40" ]; then
    is_delete=false
    break
  fi
done

if [ "$is_delete" = true ]; then
  # Branch or tag deletion, allow push immediately
  exit 0
fi

echo "🫐 [Blueberry Pre-Push] Executing local CI quality gate before push..."

if [ -f "${REPO_ROOT}/scripts/run-ci-local.sh" ]; then
  if "${REPO_ROOT}/scripts/run-ci-local.sh"; then
    echo "🫐 [Blueberry Pre-Push] ✅ All verification checks passed. Proceeding with push."
    exit 0
  else
    echo "🫐 [Blueberry Pre-Push] ❌ Local CI checks failed! Push rejected."
    echo "💡 Fix the reported errors above or test locally with: ./scripts/run-ci-local.sh"
    exit 1
  fi
else
  echo "⚠️  [Blueberry Pre-Push] ${REPO_ROOT}/scripts/run-ci-local.sh not found. Skipping."
  exit 0
fi
