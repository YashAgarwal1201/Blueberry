# ─────────────────────────────────────────────────────────────────────────────
# Blueberry Self-Hosted Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# Port Mappings
PORT_BACKEND=8100
PORT_FRONTEND=5130

# Better-Auth Configuration
# IMPORTANT: Generate a secure random string for production (openssl rand -base64 32)
BETTER_AUTH_SECRET=generate_a_random_32_character_string_here

# When accessing Blueberry via the web browser, Better-Auth generates callback
# and password reset URLs using this origin.
# For local Docker: http://localhost:5130 (or http://localhost:8100 if bypassing Nginx)
# For remote Homelab / VPS: http://<your-server-ip>:5130 or https://blueberry.yourdomain.com
BETTER_AUTH_URL=http://localhost:5130

# CORS & Trusted Origins (Comma-separated)
# Add all domains/IPs from which users will open the frontend app
FRONTEND_URL=http://localhost:5130,http://localhost:80,http://localhost

# External Metadata Ingestion (Optional)
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Database Engine Selection
# Default: Leave blank for zero-config embedded SQLite (/app/backend/data/app.db)
# Or configure a custom SQLite path / external PostgreSQL connection string:
# DATABASE_PATH=/app/backend/data/app.db
# DATABASE_URL=postgres://blueberry:blueberry_secret@postgres:5432/blueberry
DATABASE_URL=
