# The port the Hono backend server runs on
PORT=8100

# Better-Auth Secret (generate a secure random 32-character string: openssl rand -base64 32)
BETTER_AUTH_SECRET=blueberry_super_secure_production_secret_32_chars

# Base URL for Better Auth (use https://localhost:8100 if mkcert certs are present, or http://localhost:8100)
BETTER_AUTH_URL="https://localhost:8100"

# Allowed frontend origins for CORS (comma separated)
FRONTEND_URL="http://localhost:5130,http://127.0.0.1:5130,https://localhost:5130,https://127.0.0.1:5130,http://localhost:5173,https://localhost:5173"

# Additional trusted origins for Better-Auth (comma separated)
BETTER_AUTH_TRUSTED_ORIGINS=

# External Metadata Ingestion (Optional)
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Database Configuration (Optional)
# Default: embedded SQLite at data/app.db
# DATABASE_PATH=data/app.db
# DATABASE_URL=sqlite://data/app.db
