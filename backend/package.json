{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "NODE_OPTIONS=\"--max-old-space-size=1024\" jest --runInBand",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "seed:tmdb": "npx ts-node scripts/tmdb-seed.ts",
    "seed:tmdb:movies": "npx ts-node scripts/tmdb-seed.ts --movies",
    "seed:tmdb:tv": "npx ts-node scripts/tmdb-seed.ts --tv",
    "import:csv": "npx ts-node scripts/csv-import.ts",
    "import:csv:top": "npx ts-node scripts/csv-import.ts --top --limit 10000 --min-votes 100",
    "import:csv:dry": "npx ts-node scripts/csv-import.ts --dry-run",
    "import:csv:tv": "npx ts-node scripts/csv-import-tv.ts",
    "import:csv:tv:top": "npx ts-node scripts/csv-import-tv.ts --top --limit 10000 --min-votes 100",
    "import:csv:tv:dry": "npx ts-node scripts/csv-import-tv.ts --dry-run"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "shared-types": "file:../shared"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "volta": {
    "node": "24.15.0"
  }
}
